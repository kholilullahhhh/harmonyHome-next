DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/harmony_home"
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Pengingat jatuh tempo email (lib/email.ts) — opsional; tanpa SMTP_HOST
# reminder dilewati (log saja) dan tidak mengganggu halaman admin.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user@example.com"
SMTP_PASSWORD="smtp-password"
EMAIL_FROM="Harmony Home <no-reply@harmonyhome.id>"

# Secret untuk GET /api/cron/reminders (kirim lewat header x-cron-secret
# atau query ?secret=) — dipakai cron / Netlify Scheduled Function.
CRON_SECRET="ganti-dengan-secret-acak"
